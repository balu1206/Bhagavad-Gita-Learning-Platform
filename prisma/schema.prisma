// Bhagavad Gita Learning Platform — Prisma Schema
// Phase 2: User + Auth models (Chapters/Verses/Progress added in Phase 3)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────
// NextAuth.js required models
// ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────
// Core User model
// ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // bcrypt hash for credentials provider

  // Profile
  bio           String?   @db.Text
  role          Role      @default(USER)

  // Reading preferences
  fontSize      String    @default("md")
  readingTheme  String    @default("light")
  showTransliteration Boolean @default(true)
  showWordByWord  Boolean @default(false)

  // Audio preferences
  playbackSpeed Float   @default(1.0)
  autoAdvance   Boolean @default(true)

  // Streak tracking
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  lastActiveAt  DateTime?
  streakUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // XP / Gamification
  totalXp      Int     @default(0)
  level        Int     @default(1)

  // Relations
  accounts          Account[]
  sessions          Session[]
  progress          UserProgress[]
  bookmarks         Bookmark[]
  journeyProgress   UserJourneyProgress[]
  achievements      UserAchievement[]

  @@index([email])
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────────────────────────────
// Content models (Phase 3)
// ─────────────────────────────────────────────────

model Chapter {
  id          String  @id @default(cuid())
  number      Int     @unique  // 1–18
  slug        String  @unique  // "chapter-1-arjuna-vishada-yoga"
  title       String           // "Arjuna Vishada Yoga"
  titleSanskrit String        // "अर्जुन विषाद योग"
  transliteration String      // "Arjuna Viṣāda Yoga"
  summary     String  @db.Text
  verseCount  Int

  verses      Verse[]
  progress    UserProgress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([number])
}

model Verse {
  id            String  @id @default(cuid())
  chapterId     String
  number        Int                    // verse number within chapter
  globalNumber  Int     @unique        // sequential across all 700 verses
  slug          String  @unique        // "1-1", "2-47"

  // Sanskrit text
  sanskrit      String  @db.Text
  transliteration String @db.Text

  // Translation (primary — public domain)
  translation   String  @db.Text
  translationAuthor String @default("Edwin Arnold")

  // Word-by-word (JSON array of {word, meaning} objects)
  wordByWord    Json?

  // Commentary
  commentary    String? @db.Text
  commentaryAuthor String?

  // Audio
  audioUrl      String?

  chapter       Chapter       @relation(fields: [chapterId], references: [id])
  bookmarks     Bookmark[]
  progress      UserProgress[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chapterId, number])
  @@index([chapterId])
  @@index([globalNumber])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  verseId     String
  chapterId   String
  readAt      DateTime @default(now())
  listenedAt  DateTime?
  bookmarked  Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse       Verse    @relation(fields: [verseId], references: [id])
  chapter     Chapter  @relation(fields: [chapterId], references: [id])

  @@unique([userId, verseId])
  @@index([userId])
  @@index([userId, chapterId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  verseId   String
  note      String?  @db.Text
  tags      String[] // simple string array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse     Verse    @relation(fields: [verseId], references: [id])

  @@unique([userId, verseId])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// Phase 6: Beginner Journey models
// ─────────────────────────────────────────────────

model JourneyStep {
  id          String  @id @default(cuid())
  order       Int     @unique   // 1–8
  slug        String  @unique   // "introduction", "key-concepts", etc.
  title       String            // "Introduction to the Gita"
  subtitle    String            // brief description
  icon        String            // emoji or icon name
  estimatedMinutes Int @default(15)

  lessons     Lesson[]
  quizQuestions QuizQuestion[]
  userProgress UserJourneyProgress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Lesson {
  id            String  @id @default(cuid())
  stepId        String
  order         Int                    // order within step
  title         String
  content       String  @db.Text       // Markdown content
  verseRefs     String[]               // e.g. ["2.47", "4.7"]
  estimatedMinutes Int @default(5)

  step          JourneyStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([stepId, order])
  @@index([stepId])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  stepId      String
  order       Int
  question    String   @db.Text
  options     String[]          // 4 answer options
  correctIndex Int              // 0-based index of correct option
  explanation String  @db.Text  // explanation shown after answering

  step        JourneyStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, order])
  @@index([stepId])
}

model UserJourneyProgress {
  id            String   @id @default(cuid())
  userId        String
  stepId        String
  status        StepStatus @default(LOCKED)
  lessonsRead   Int        @default(0)
  quizScore     Int?                   // null = not taken, 0-100
  quizPassed    Boolean    @default(false)
  completedAt   DateTime?
  startedAt     DateTime?

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  step          JourneyStep @relation(fields: [stepId], references: [id])

  @@unique([userId, stepId])
  @@index([userId])
}

enum StepStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

// ─────────────────────────────────────────────────
// Achievement / Gamification models
// ─────────────────────────────────────────────────

model Achievement {
  id          String  @id @default(cuid())
  slug        String  @unique   // "first-step", "week-streak", etc.
  title       String
  description String
  icon        String            // emoji
  xpReward    Int     @default(50)
  rarity      AchievementRarity @default(COMMON)

  userAchievements UserAchievement[]

  createdAt   DateTime @default(now())
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  xpAwarded     Int

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}
